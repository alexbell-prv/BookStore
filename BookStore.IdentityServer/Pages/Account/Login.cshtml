@page
@model BookStore.IdentityServer.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
}
<h1>Sign in</h1>
<p>Sign in to search the bookstore catalog.</p>
<form method="post">
    <div asp-validation-summary="All" role="alert"></div>
    <input type="hidden" asp-for="ReturnUrl" />
    <label asp-for="Input.Username">Username</label>
    <input asp-for="Input.Username" autocomplete="username" autofocus required />
    <label asp-for="Input.Password">Password</label>
    <input asp-for="Input.Password" type="password" autocomplete="current-password" required />
    <button type="submit">Sign in</button>
</form>
